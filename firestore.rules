rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // دالة فحص تسجيل الدخول عبر فايربيز
    function isAuthenticated() {
      return request.auth != null;
    }

    // دالة فحص حساب السيد مدير التربية
    function isDirector() {
      return isAuthenticated() && (
        request.auth.token.email == "director_touggourt@system.local" ||
        request.auth.uid == "DIRECTOR_ACCESS"
      );
    }

    // دالة فحص حساب الإدارة المركزية
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "admin_directorate@system.local" ||
        request.auth.uid == "ADMIN_ACCESS" ||
        request.auth.token.email == "director_touggourt@system.local" ||
        request.auth.uid == "DIRECTOR_ACCESS"
      );
    }

    // دالة فحص حساب المفتش / المشرف
    function isInspector() {
      return isAuthenticated() && (
        request.auth.token.email.matches('.*@system[.]local') ||
        request.auth.token.email.matches('.*@.*') ||
        exists(/databases/$(database)/documents/center_admins/$(request.auth.uid))
      );
    }

    // 1. إعدادات الموقع المركزية والمراكز (site_settings & center_settings)
    match /site_settings/{document=**} {
      allow read, write: if true;
    }
    match /center_settings/{document=**} {
      allow read, write: if true;
    }

    // 2. ملف الأرقام السرية والحماية (config/pass)
    match /config/pass {
      allow read: if true; 
      allow write: if isAdmin();
    }
    match /config/{document=**} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // 3. حسابات المشرفين والمفتشين (center_admins)
    match /center_admins/{adminId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // 4. قاعدة بيانات الأساتذة المتربصين (employeescomnew)
    match /employeescomnew/{empId} {
      allow read: if true;
      allow update: if (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pob', 'daira', 'adrs', 'phone', 'infoCompleted'])
      ) || isAdmin() || isInspector() || true;
      allow create, delete: if isAdmin() || isInspector();
    }

    // 5. سجل الحضور والغياب اليومي (attendance_daily & attendance)
    match /attendance_daily/{recordId} {
      allow read, write: if true;
    }
    match /attendance/{recordId} {
      allow read, write: if true;
    }

    // 5.1 روابط الماسح الضوئي الموحد (scanner_tokens)
    match /scanner_tokens/{tokenId} {
      allow read, write: if true;
    }

    // 6. إدارة النقاط والتقييمات (training_grades & grades)
    match /training_grades/{gradeId} {
      allow read, write: if true;
    }
    match /grades/{gradeId} {
      allow read, write: if true;
    }

    // 7. إدارة المؤطرين والحضور (center_framers & framers & attendance)
    match /center_framers/{framerId} {
      allow read, write: if true;
    }
    match /framers/{framerId} {
      allow read, write: if true;
    }
    match /framers_attendance_daily/{recordId} {
      allow read, write: if true;
    }

    // 7.1 قاعدة بيانات الموظفين والمؤطرين التكميلية (employeescomplus)
    match /employeescomplus/{empId} {
      allow read, write: if true;
    }

    // 7.2 حسابات الأساتذة المؤطرين (supervisor_accounts)
    match /supervisor_accounts/{accId} {
      allow read, write: if true;
    }

    // 8. نظام المراسلات والملفات (messages)
    match /messages/{messageId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 9. نظام الإشعارات والتنبيهات (notifications)
    match /notifications/{notifId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || isInspector() || true;
    }

    // 10. نظام السنوات التكوينية والأرشيف (training_years & training_years_archives)
    match /training_years/{yearId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /training_years_archives/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // القاعدة الافتراضية لأي مجموعة أخرى غير معلنة
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
