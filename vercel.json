{
  "rewrites": [
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/portal",
      "destination": "/dashboard.html"
    },
    {
      "source": "/courses",
      "destination": "/courses.html"
    },
    {
      "source": "/inspector",
      "destination": "/inspector_dashboard.html"
    },
    {
      "source": "/admin-panel",
      "destination": "/admin_dashboard.html"
    },
    {
      "source": "/secure-login",
      "destination": "/admin095526.html"
    },
    {
      "source": "/framers",
      "destination": "/framers_management.html"
    },
    {
      "source": "/grades",
      "destination": "/grades_management.html"
    },
    {
      "source": "/courses-manage",
      "destination": "/manage_courses.html"
    },
    {
      "source": "/scanner-tool",
      "destination": "/scanner.html"
    },
    {
      "source": "/statistics",
      "destination": "/tracking.html"
    },
    {
      "source": "/files-upload",
      "destination": "/dashboard_finale_upload.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}